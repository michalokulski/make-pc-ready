root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ps1]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false

[*.xml]
indent_style = tab
indent_size = 4

[*.sh]
indent_style = tab
indent_size = 4
end_of_line = lf

[*.json]
indent_style = space
indent_size = 2

[*.yml]
indent_style = space
indent_size = 2

[.gitignore]
indent_style = space
indent_size = 4